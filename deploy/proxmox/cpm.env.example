# =============================================================================
# Caddy Proxy Manager — Proxmox Environment Configuration
# =============================================================================
# Copy this file to /etc/cpm/cpm.env and update with your secure values.
# Protect it: chmod 600 /etc/cpm/cpm.env
# =============================================================================

# Node environment
NODE_ENV=production

# =============================================================================
# REQUIRED SECURITY SETTINGS
# =============================================================================

# Session Secret (REQUIRED)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-secure-session-secret-here-min-32-chars

# Admin Credentials (REQUIRED)
# Password: 12+ chars, uppercase, lowercase, numbers, special characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Your-Secure-P@ssw0rd-Here!

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Public base URL — the URL users access in their browser
BASE_URL=http://localhost:3000

# Caddy Admin API — CPM communicates with Caddy here
# When Caddy runs on the same host: http://localhost:2019
CADDY_API_URL=http://localhost:2019

# Config mode: "replace" (full POST /load) or "merge" (preserves user Caddyfile)
# Use "merge" to keep custom Caddyfile entries alongside CPM-managed proxy hosts
CADDY_CONFIG_MODE=merge

# Forward auth internal URL — Caddy uses this to reach CPM's auth endpoint
# Points to the local CPM instance (same host)
FORWARD_AUTH_INTERNAL_URL=http://localhost:3000

# =============================================================================
# DATABASE
# =============================================================================

DATABASE_PATH=/var/lib/cpm/caddy-proxy-manager.db
DATABASE_URL=file:/var/lib/cpm/caddy-proxy-manager.db
CERTS_DIRECTORY=/var/lib/cpm/certs

# =============================================================================
# LOGIN RATE LIMITING (optional)
# =============================================================================

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=300000
LOGIN_BLOCK_MS=900000
